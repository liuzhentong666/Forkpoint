{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["oss:GetBucketVersioning", "oss:GetBucketWorm", "oss:GetBucketObjectWormConfiguration"],
      "Resource": ["acs:oss:*:*:your-oss-bucket"]
    },
    {
      "Effect": "Allow",
      "Action": ["oss:GetObject", "oss:PutObject"],
      "Resource": ["acs:oss:*:*:your-oss-bucket/agentdb-state/*"]
    }
  ]
}
